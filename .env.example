# ---- X (Twitter) OAuth 2.0 ----
# developer.x.com -> your app -> "User authentication settings":
#   Type: Web App; Callback URL: https://YOUR-DOMAIN/api/auth/x/callback
#   (for local dev add http://localhost:3000/api/auth/x/callback too)
#   Scopes used: tweet.read users.read offline.access
X_CLIENT_ID=
# Only for "confidential" clients. Leave empty for a public (PKCE-only) client.
X_CLIENT_SECRET=
# Optional app-only bearer token, used for cheaper tweet lookups in the cron.
X_BEARER_TOKEN=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TICKER=SHILL
NEXT_PUBLIC_TOKEN_CA=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
# Secret used to sign session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Comma separated X usernames allowed to call admin endpoints (no @)
ADMIN_USERNAMES=

# ---- Rewards ----
# "views:sol" pairs, ascending. A tweet earns the highest tier it reaches.
REWARD_TIERS=100:0.1,500:0.2,1000:0.3,2500:0.5,5000:0.75,10000:1
# Hours a tweet keeps being tracked after posting (final tier is locked after this)
TRACK_HOURS=48
# Max rewarded tweets per user per UTC day
MAX_REWARDED_PER_DAY=3
# Minimum minutes between two manual syncs for the same user
SYNC_COOLDOWN_MIN=10
# Only tweets posted after this ISO date count (launch time). Empty = user's signup time.
CAMPAIGN_START=

# ---- Bot / fake-reach filter ----
MIN_ACCOUNT_AGE_DAYS=30
MIN_FOLLOWERS=50
# Views above followers * this ratio are suspicious (bought impressions)
MAX_VIEWS_PER_FOLLOWER=40
# Below this engagement rate (likes+replies+reposts+quotes+bookmarks / views) a tweet with
# 1000+ views is treated as botted. 0.003 = 0.3%
MIN_ENGAGEMENT_RATE=0.003
# Count replies as eligible tweets (default: only original posts)
ALLOW_REPLIES=false

# ---- Upstash Redis (falls back to in-memory locally) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Solana payouts ----
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Treasury keypair: base58 secret key OR JSON array. Keep it out of git.
TREASURY_SECRET_KEY=
# "true" sends real SOL from the cron. Anything else = dry run (rewards accrue, nothing is sent).
PAYOUTS_LIVE=false
# Minimum SOL owed before a payout is sent (keeps tx fees sane)
MIN_PAYOUT_SOL=0.1
